{
  "name": "@coyote-force/ui",
  "version": "0.1.0",
  "description": "Coyote Force Design System — shadcn/ui primitives, tokens, and utilities.",
  "license": "MIT",
  "private": true,
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coyote-force/design-system.git",
    "directory": "packages/ui"
  },
  "homepage": "https://design.coyoteforce.com",
  "bugs": {
    "url": "https://github.com/coyote-force/design-system/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./chart": {
      "import": {
        "types": "./dist/chart.d.ts",
        "default": "./dist/chart.js"
      },
      "require": {
        "types": "./dist/chart.d.cts",
        "default": "./dist/chart.cjs"
      }
    },
    "./charts/area": {
      "import": {
        "types": "./dist/charts/area.d.ts",
        "default": "./dist/charts/area.js"
      },
      "require": {
        "types": "./dist/charts/area.d.cts",
        "default": "./dist/charts/area.cjs"
      }
    },
    "./charts/bar": {
      "import": {
        "types": "./dist/charts/bar.d.ts",
        "default": "./dist/charts/bar.js"
      },
      "require": {
        "types": "./dist/charts/bar.d.cts",
        "default": "./dist/charts/bar.cjs"
      }
    },
    "./charts/line": {
      "import": {
        "types": "./dist/charts/line.d.ts",
        "default": "./dist/charts/line.js"
      },
      "require": {
        "types": "./dist/charts/line.d.cts",
        "default": "./dist/charts/line.cjs"
      }
    },
    "./charts/pie": {
      "import": {
        "types": "./dist/charts/pie.d.ts",
        "default": "./dist/charts/pie.js"
      },
      "require": {
        "types": "./dist/charts/pie.d.cts",
        "default": "./dist/charts/pie.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      },
      "require": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      }
    },
    "./styles": "./styles/globals.css",
    "./fonts": "./styles/fonts.css",
    "./components.json": "./components.json",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "chart": [
        "./dist/chart.d.ts"
      ],
      "charts/area": [
        "./dist/charts/area.d.ts"
      ],
      "charts/bar": [
        "./dist/charts/bar.d.ts"
      ],
      "charts/line": [
        "./dist/charts/line.d.ts"
      ],
      "charts/pie": [
        "./dist/charts/pie.d.ts"
      ],
      "utils": [
        "./dist/utils.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "styles",
    "components.json",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "check:exports": "publint && attw --pack --ignore-rules no-resolution",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "react": ">=18.3 <20",
    "react-dom": ">=18.3 <20",
    "shadcn": "^4.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "shadcn": {
      "optional": false
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.14.0",
    "react-hook-form": "^7.73.1",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.5",
    "jsdom": "^29.0.2",
    "publint": "^0.3.18",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  }
}
